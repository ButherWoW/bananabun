# Run node platform/setup-local.mjs to create private random values without printing them.
DB_PASSWORD=
JWT_SECRET=
LOCAL_DB_PORT=54329

# Server public URL (no trailing slash)
PUBLIC_URL=https://nespizdili.lol

# Uploads directory (absolute path on server)
UPLOADS_DIR=/opt/affiliate/uploads

# TikTok Ads API (get from developers.tiktok.com)
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=https://nespizdili.lol/api/tiktok/oauth/callback
